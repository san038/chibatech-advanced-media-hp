{
  "name": "chibatech-adm-hp",
  "private": true,
  "type": "module",
  "imports": {
    "#internal/nuxt/paths": "./scripts/shims/nuxt-internal-paths.mjs"
  },
  "engines": {
    "node": ">=20 <=24"
  },
  "scripts": {
    "build": "node scripts/build-note-data.mjs && nuxt build",
    "dev": "nuxt dev",
    "generate": "node scripts/build-note-data.mjs && nuxt generate",
    "generate:gh-pages": "node scripts/build-note-data.mjs && nuxt generate && cp .output/public/index.html .output/public/404.html",
    "preview": "nuxt preview",
    "start": "npx serve .output/public",
    "postinstall": "nuxt prepare"
  },
  "devDependencies": {
    "@nuxt/eslint": "^0.7.0",
    "nuxt": "^3.17.7",
    "typescript": "^5.7.2",
    "vue-tsc": "^3.2.7"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0"
  }
}
